# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Database
DATABASE_URL="postgresql://cineverse:cineverse@localhost:5432/cineverse?schema=public"
DIRECT_URL="postgresql://cineverse:cineverse@localhost:5432/cineverse?schema=public"

# NextAuth v4
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-secret

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email magic link
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="CineVerse AI <noreply@cineverse.ai>"

# The Movie Database (TMDB) API settings
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=
YOUTUBE_API_KEY=

# Security / Cron
CRON_SECRET=replace-with-cron-secret
RATE_LIMIT_SECRET=replace-with-rate-limit-secret

# Optional Redis / Observability
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
