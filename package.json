{
  "name": "cineverse-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "NODE_OPTIONS=--max-old-space-size=2048 eslint src middleware.ts next.config.ts --max-warnings=0",
