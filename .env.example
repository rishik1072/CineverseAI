# ============================================================================
# CineVerse AI - Environment Variables Configuration
# ============================================================================
# Copy this file to .env.local and fill in the required values.
# For Vercel deployment, add variables via the Vercel dashboard.
# ============================================================================

# Application Settings
# ============================================================================
# NEXT_PUBLIC_APP_URL: Your application's public URL
#   - Local: http://localhost:3000
#   - Vercel: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# APP_ENV: Environment name (development, staging, production)
APP_ENV=development

# Database Configuration (REQUIRED)
# ============================================================================
# Use PostgreSQL connection strings. For Vercel, use Vercel Postgres or
# connect to your existing PostgreSQL instance.
#
# DATABASE_URL: Primary database connection (pooled, recommended for Vercel)
#   Format: postgresql://user:password@host:port/database?schema=public
#
# DIRECT_URL: Direct database connection (for migrations, Prisma CLI)
#   - Can be same as DATABASE_URL or a direct connection
#   - Vercel: Generate from dashboard and set DIRECT_URL separately
#
# Generate secure DATABASE_URL and DIRECT_URL from your database provider:
# - Vercel Postgres: https://vercel.com/docs/storage/postgres
# - Railway: https://railway.app
# - Render: https://render.com
# - Supabase: https://supabase.com
DATABASE_URL="postgresql://user:password@localhost:5432/cineverse?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/cineverse?schema=public"

# NextAuth Configuration (REQUIRED)
# ============================================================================
# Generate NEXTAUTH_SECRET using: openssl rand -hex 32
# For Vercel, generate a new secret and store in environment variables.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-32-char-hex-secret-generate-with-openssl-rand-hex-32

# OAuth Providers (Optional but recommended)
# ============================================================================
# Google OAuth:
#   1. Go to https://console.cloud.google.com
#   2. Create OAuth 2.0 Credentials (Web application)
#   3. Add http://localhost:3000/api/auth/callback/google to authorized redirect URIs
#   4. Add https://your-project.vercel.app/api/auth/callback/google for production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth:
#   1. Go to https://github.com/settings/developers
#   2. Create OAuth App
#   3. Set Authorization callback URL to http://localhost:3000/api/auth/callback/github
#   4. Add https://your-project.vercel.app/api/auth/callback/github for production
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Magic Link (Optional)
# ============================================================================
# For magic link authentication via email.
# Provider examples: Gmail SMTP, SendGrid, Postmark, AWS SES
#
# Gmail SMTP:
#   - Host: smtp.gmail.com
#   - Port: 587
#   - Use "App Password" (not regular password) for security
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="CineVerse AI <noreply@cineverse.ai>"

# TMDB API Configuration (Optional but recommended for features)
# ============================================================================
# The Movie Database API: https://www.themoviedb.org/settings/api
#   1. Sign up for free account
#   2. Request API key from Settings > API
#   3. Use key for TMDB_API_KEY
#
# If TMDB_API_KEY is missing, the app gracefully falls back to static content.
# Build will NOT fail. Sitemap, robots.txt, and manifest will be generated
# without TMDB data, but some features will be limited.
TMDB_API_KEY=
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# OMDB API (Optional)
# ============================================================================
# OMDb API for additional movie metadata: http://www.omdbapi.com
OMDB_API_KEY=

# YouTube API (Optional)
# ============================================================================
# YouTube Data API for fetching video information
YOUTUBE_API_KEY=

# Security & Rate Limiting (Optional)
# ============================================================================
# Generate secure random secrets for:
# - CRON_SECRET: Protect cron jobs from unauthorized access
# - RATE_LIMIT_SECRET: Rate limiter encryption key
CRON_SECRET=your-cron-secret-generate-with-openssl-rand-hex-32
RATE_LIMIT_SECRET=your-rate-limit-secret-generate-with-openssl-rand-hex-32

# Observability & Monitoring (Optional)
# ============================================================================
# Upstash Redis: https://upstash.com
#   - Used for rate limiting, caching, real-time features
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry: https://sentry.io
#   - Error tracking and performance monitoring
SENTRY_DSN=

# PostHog: https://posthog.com
#   - Product analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ============================================================================
# VERCEL DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying to Vercel:
#
# 1. Database:
#    ✓ Set DATABASE_URL (pooled connection)
#    ✓ Set DIRECT_URL (direct connection for migrations)
#    ✓ Verify connection works
#
# 2. Authentication:
#    ✓ Generate and set NEXTAUTH_SECRET
#    ✓ Add NEXTAUTH_URL to your Vercel domain
#    ✓ Configure OAuth callback URLs in provider settings
#
# 3. APIs:
#    ✓ Set TMDB_API_KEY (or app will fallback gracefully)
#    ✓ Set other optional API keys as needed
#
# 4. Security:
#    ✓ Generate and set CRON_SECRET
#    ✓ Generate and set RATE_LIMIT_SECRET
#
# 5. Vercel Dashboard:
#    ✓ Go to Project Settings > Environment Variables
#    ✓ Add all production values
#    ✓ Mark NEXT_PUBLIC_* as available in browser
#    ✓ Verify sensitive secrets are only available server-side
#
# 6. Deployment:
#    ✓ Trigger new deployment after setting env vars
#    ✓ Monitor build logs for warnings/errors
#    ✓ Test authentication flows
#    ✓ Verify API endpoints work
#
# ============================================================================
# LOCAL DEVELOPMENT
# ============================================================================
# 1. Copy this file: cp .env.example .env.local
# 2. Update all values for your local setup
# 3. Run: pnpm dev
# 4. Database: Start PostgreSQL (Docker, local, or remote)
# 5. Test: http://localhost:3000
#
# Docker PostgreSQL example:
#   docker run --name postgres -e POSTGRES_PASSWORD=cineverse \
#     -e POSTGRES_DB=cineverse -p 5432:5432 -d postgres:15
#
# ============================================================================
